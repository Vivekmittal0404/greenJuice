# Merchant UPI details. Put real values in .env.local or hosting env vars.
UPI_ID=your-store@upi
UPI_NAME=Root and Ritual

# Supabase project URL and server-only secret API key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# Resend order email. Keep the API key server-only.
RESEND_API_KEY=re_your_api_key
ORDER_NOTIFICATION_EMAIL=store@gmail.com
RESEND_FROM_EMAIL=Root and Ritual <orders@your-verified-domain.com>
